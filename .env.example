# Copy to .env and fill in. Never commit .env.

# --- required: OpenAI drives the agent + RAG embeddings ---
OPENAI_API_KEY=sk-your-key-here
EMBED_MODEL=text-embedding-3-small

# --- optional: provider swap ---
# ANTHROPIC_API_KEY=sk-ant-your-key

# --- optional: LangSmith observability ---
# LANGSMITH_API_KEY=ls-your-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langchain-testing-mastery

# --- optional: weather tool ---
# OPENWEATHER_API_KEY=your-key

# --- optional: live MCP tools (toggle in the sidebar) ---
# Jira (same as the MCP app):
# JIRA_URL=https://YOURNAME.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=your-classic-jira-token
# Gmail (same as the MCP app — path to your OAuth client JSON):
# GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
